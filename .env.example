# Supabase (PRD 9.7). Get these from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans Snap billing. Sandbox is the default unless explicitly enabled.
MIDTRANS_SERVER_KEY=
# Optional metadata for embedded Snap integrations; redirect checkout only needs
# MIDTRANS_SERVER_KEY.
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# Root domain the app is served on. Used by middleware to tell the app itself
# apart from a published site's subdomain (PRD 9.3, 9.7).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Google OAuth (Fase 2): provider settings live in the Supabase Dashboard
# (Authentication → Providers → Google), NOT here. In Supabase you must:
#   1. Set the Google client ID/secret from the Google Cloud Console.
#   2. In Google Cloud Console, add the OAuth redirect URI:
#      <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback
#   3. In Supabase → Auth → URL Configuration, set Site URL to your app origin
#      (http://localhost:3000 locally) so signInWithOAuth resolves redirects.
# The app's callback handler is <app origin>/auth/callback (code exchange).

# Vercel Cron Secret (PRD 7.6). Used to secure background subscription expiration checks.
CRON_SECRET=

# Vercel Domain API (PRD §9A billing-002 — Premium/Enterprise custom domains).
# https://vercel.com/docs/rest-api/reference/endpoints/domains
# Without these, custom-domain connect silently no-ops in dev (see
# src/lib/domains/vercel.ts) instead of calling the live API.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Only needed if the Vercel project lives under a team scope.
VERCEL_TEAM_ID=
